{
  // Exact's build reads this file too: it takes only `paths` and `baseUrl`, and refuses an `extends` of a package.
  "compilerOptions": { "strict": true, "target": "ESNext", "module": "ESNext", "moduleResolution": "bundler", "allowImportingTsExtensions": true, "noEmit": true },
  // `tsc` checks the Expo API routes; every Exact build type-checks app.ts with Exact's own settings.
  "include": ["src"]
}
