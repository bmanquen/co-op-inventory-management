// The coffee inventory app on Exact: the React Native app's behaviour and colours (app.forma),
// laid out as a web app: tabs across the top, a readable centred width, a store dropdown.
// Data comes from server.ts (Turso), behind a shared team code.
use EmptyState from "exact:content"

routes nav
  tab stock "/"
    // The store picker on a phone: a sheet over Stock. The web uses a dropdown and never opens it.
    pick "/pick"
  tab products "/products"
  tab stores "/stores"

// Every painted button: a slight press, so a tap feels heard (the hover wash is Exact's).
style Press
  transition = "scale 160ms cubic-bezier(0.23, 1, 0.32, 1)"
  :active
    -exact-press-scale = 0.97

// The store dropdown grows out of its button: a short ease-out, never from nothing.
keyframes menuIn
  from opacity=0 translate="0px -4px" scale=0.97

shape Media
  prefersReducedMotion: bool

shape Item
  id: string
  name: string
  // Products out (0) and low (1–3) at a store; 0 for products.
  out: number
  low: number

shape Names
  // Which code read this list, and whether the server refused it.
  code: string
  denied: bool
  items: Item[]
  // The last list the server sent, shown while it can't be reached.
  offline: bool

shape Line
  id: string
  name: string
  count: number

shape Stock
  // Which store these lines are for: retained lines from another store stay hidden while it loads.
  store: string
  lines: Line[]
  // +/− taps saved on this device that the server hasn't taken yet, and whether the server was unreachable.
  waiting: number
  offline: bool
  // Why the server refused a waiting tap this load dropped, else "".
  dropped: string

// Which host draws the app: the store picker is a dropdown on the web and a sheet on phones.
shape Host
  web: bool

// Android's top app bar has no item for a readout (role="status"), so there the header stays in the page.
shape Page
  platform: string

shape Reply
  ok: bool
  error: string

fn replyError(r: option<Reply>): string = match r { case some(x) => x.error, case none => "" }
// At or below this count a product needs restocking.
fn isLow(n: number): bool = n <= 3

component App
  // Kept across launches, as the React Native app keeps them in AsyncStorage.
  state code = "" persist
  state picked = "" persist
  state draftCode = ""
  state needsOnly = false
  state storeQuery = ""
  state newProduct = ""
  state newStore = ""
  state addingTo = ""
  state addedName = ""
  // Which kind of save the person made last, so the status speaks for that one.
  state lastWrite = ""
  state doomedList = ""
  state doomedId = ""
  state doomedName = ""
  // The count being typed; it saves when the field loses focus, as React Native's onBlur does.
  state countId = ""
  state countDraft = ""
  // The last typed count, for Undo.
  state undoShown = false
  state undoStore = ""
  state undoProduct = ""
  state undoName = ""
  state undoBefore = 0
  state undoCount = 0
  resource media = exactViewport() as shape Media
  resource host = whichHost() as shape Host else empty()
  resource page = exactPage() as shape Page
  derive android = page.platform == "android"
  resource stores = loadStores(code) as shape Names else empty()
  resource products = loadProducts(code) as shape Names else empty()
  // The picked store while it still exists, else the first one.
  derive current = stores.items.map(s => s.id).includes(picked) ? picked : match first(stores.items) { case some(s) => s.id, case none => "" }
  derive currentName = match first(stores.items.filter(s => s.id == current)) { case some(s) => s.name, case none => "" }
  resource stock = loadStock(code, current) as shape Stock else empty()
  mutation checked as shape Reply then afterCheck
  // Taps overlap: each +/− and typed count is its own write, shown at once by app.ts's overlay.
  mutation adjusted as shape Reply parallel refreshes stock, stores
  mutation counted as shape Reply parallel refreshes stock, stores
  mutation added as shape Reply refreshes stores, products, stock then afterAdd
  mutation removed as shape Reply refreshes stores, products, stock
  mutation cleared as shape Reply

  // A saved code the server no longer accepts sends the person back to sign in.
  derive denied = stores.code == code and stores.denied
  derive signedIn = code != "" and not denied
  derive signInError = replyError(checked) != "" ? replyError(checked) : denied ? "Wrong team code." : ""
  derive saving = pending(adjusted) or pending(counted) or pending(added) or pending(removed)
  // Why the latest save failed. An older failure of another kind (a delete) no longer shows once later saves work.
  derive saveError = (lastWrite == "adjusted" ? replyError(adjusted) : lastWrite == "counted" ? replyError(counted)
    : lastWrite == "added" ? replyError(added) : lastWrite == "removed" ? replyError(removed) : "")
  derive failed = not saving and saveError != ""
  // A failed read keeps its last answer (or its empty placeholder), so say the server is unreachable.
  derive offline = failed(stores) or failed(products) or failed(stock) or stores.offline or products.offline or stock.offline
  derive restock = stock.lines.filter(l => isLow(l.count))
  derive shown = needsOnly ? restock : stock.lines
  // An add field's name already in its list, as typed ("downtown" finds "Downtown"), checked before it's sent.
  derive dupProduct = match first(products.items.filter(p => p.name.toLowerCase() == newProduct.trim().toLowerCase())) { case some(p) => p.name, case none => "" }
  derive dupStore = match first(stores.items.filter(s => s.name.toLowerCase() == newStore.trim().toLowerCase())) { case some(s) => s.name, case none => "" }
  // What each add field says under it: the duplicate as you type, else why the last add of the name still there failed.
  derive addFailed = not pending(added) and replyError(added) != ""
  derive productNote = dupProduct != "" ? `“${dupProduct}” is already on the list.` : addFailed and addingTo == "products" and newProduct.trim() == addedName ? replyError(added) : ""
  derive storeNote = dupStore != "" ? `“${dupStore}” is already on the list.` : addFailed and addingTo == "stores" and newStore.trim() == addedName ? replyError(added) : ""
  derive storeMatches = stores.items.filter(s => s.name.toLowerCase().includes(storeQuery.trim().toLowerCase()))

  // Other people's changes arrive by polling, every 10 s as in the React Native app.
  task poll mount
    every(10000, pull)
  // Undo is offered only once the typed count is saved: it sends the difference, which on a count
  // the server never took (offline, refused) or hasn't taken yet would change the real count.
  derive canUndo = undoShown and not pending(counted) and replyError(counted) == ""
  task hideUndo when undoShown
    after(4000, dismissUndo)

  action pull
    refresh stores
    refresh products
    refresh stock
  action tab(name: string)
    nav = select(nav, name)
  action follow(url: string)
    nav = go(nav, url)

  action editCode(v: string)
    draftCode = v
  action signIn
    if draftCode.trim() != "" and not pending(checked)
      send checked = checkCode(draftCode.trim())
  // Asks first: on a shared device, the person may not know the team code to sign back in.
  action askSignOut
    showModal("sign-out")
  // Forgets the saved code on this device; the sign-in screen shows again.
  action signOut
    send cleared = clearDevice()
    code = ""
    undoShown = false
    // So the next person doesn't see this one's failed save as "Not saved".
    lastWrite = ""
  action afterCheck
    if replyError(checked) == ""
      code = draftCode.trim()
      draftCode = ""

  // On the web the store button opens the dropdown itself (popovertarget); elsewhere, the sheet route.
  action openStores
    storeQuery = ""
    if not host.web
      nav = go(nav, "/pick")
  action closeStores
    if host.web
      hidePopover("store-menu")
    else
      nav = back(nav)
  action editStoreQuery(v: string)
    storeQuery = v
  action pickStore(id: string)
    picked = id
    closeStores()
  // Return picks the first match.
  action pickFirstStore
    if storeMatches.length > 0
      picked = match first(storeMatches) { case some(s) => s.id, case none => picked }
      closeStores()
  action showRestock(on: bool)
    needsOnly = on

  action adjust(id: string, delta: number)
    send adjusted = adjustStock(code, current, id, delta)
    lastWrite = "adjusted"
  // The field takes digits only: other characters are dropped as they're typed or pasted ("1,500" is 1500),
  // and an edit with no digits at all ("abc" over 40) leaves the field as it was.
  action editCount(id: string, count: number, v: string)
    let digits = v.split("").filter(c => "0123456789".includes(c)).join("")
    let was = countId == id ? countDraft : `${count}`
    countId = id
    countDraft = digits == "" and v != "" ? was : digits
  // An empty field saves 0, as React Native's Number("") does. Then Undo is offered.
  action saveCount(id: string, name: string, before: number)
    if countId == id
      let n = match parseNumber(countDraft) { case some(x) => min(1000000, max(0, floor(x))), case none => 0 }
      countId = ""
      if n != before
        send counted = setStock(code, current, id, n)
        lastWrite = "counted"
        undoStore = current
        undoProduct = id
        undoName = name
        undoBefore = before
        undoCount = n
        undoShown = true
  // Undo takes back only this change, as +/− do, so a tap someone else made meanwhile stays.
  action undo
    if canUndo
      send adjusted = adjustStock(code, undoStore, undoProduct, undoBefore - undoCount)
      lastWrite = "adjusted"
    undoShown = false
  action dismissUndo
    undoShown = false

  action editNew(list: string, v: string)
    if list == "products"
      newProduct = v
    else
      newStore = v
  action addNew(list: string)
    let name = (list == "products" ? newProduct : newStore).trim()
    if name != "" and not pending(added) and (list == "products" ? dupProduct : dupStore) == ""
      send added = addName(code, list, name)
      lastWrite = "added"
      addingTo = list
      addedName = name
  // The field clears only once the server took the name, so a refused or offline add keeps it to retry,
  // and only if it still holds that name, so text typed while it saved stays.
  action afterAdd
    if replyError(added) == ""
      if addingTo == "products" and newProduct.trim() == addedName
        newProduct = ""
      if addingTo == "stores" and newStore.trim() == addedName
        newStore = ""
  action askRemove(list: string, id: string, name: string)
    doomedList = list
    doomedId = id
    doomedName = name
    showModal("remove")
  action remove
    send removed = removeName(code, doomedList, doomedId)
    lastWrite = "removed"

  view
    // navigationBack names the sheet's close button: a swipe down presses it.
    main navigationKey=`${top(nav).id}` navigationBack="close" navigate=follow testId="app" width="100%" height="100%"
      display="flex" flex-direction="column" color-scheme="light" background-color="surface"
      // The tabs stay in the tree while signed out, hidden, so the routes keep their panels.
      column flex=1 min-height=0 position="relative" display=(signedIn ? "flex" : "none")
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              if e.name == "pick"
                // A phone's store picker, as iOS's own pickers are: a sheet with a title bar, a close
                // button, a search field in the bar, and the stores in an inset list, the current one checked.
                column navigationKey=`${e.id}` navigationPresentation="modal" navigationDetent="medium large"
                  navigationScroll="store-list" position="absolute" inset=0 display="flex" flex-direction="column" accent-color="brand"
                  // Where the sheet paints its header (Android), the search wraps under the title rather than squeezing it.
                  header display="flex" flex-wrap="wrap" align-items="center" column-gap="8px" padding="8px 16px"
                    button id="close" press=closeStores aria-label="Close" testId="store-close"
                      image "symbol:close"
                    text "Choose a Store" role="heading" aria-level=2 flex=1
                    input type="search" value=storeQuery input=editStoreQuery submit=pickFirstStore placeholder="Search"
                      aria-label="Search stores" testId="store-search" width="100%"
                  list id="store-list" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                    section
                      for s in storeMatches key=s.id
                        button press=pickStore(s.id) role="radio" aria-checked=(s.id == current) testId=`pick-${s.id}`
                          column flex=1 min-width=0
                            text s.name overflow-wrap="break-word"
                            row gap="4px"
                              if s.out > 0
                                text `${s.out} out` font="-exact-footnote" color="out.ink"
                              if s.out > 0 and s.low > 0
                                text "·" font="-exact-footnote" color="ink.muted"
                              if s.low > 0
                                text `${s.low} low` font="-exact-footnote" color="low.ink"
                          if s.id == current
                            image "symbol:checkmark" color="brand"
                      if storeMatches.length == 0
                        row
                          text `No stores match “${storeQuery}”` color="ink.empty"
              else
                column navigationKey=`${e.id}` navigationBar=(android ? "none" : "auto") position="absolute" inset=0 display="flex" flex-direction="column" background-color="surface" accent-color="brand"
                  // The route's first child, so on iOS it is the platform's navigation bar with a large title.
                  Bar(title=(t.name == "stock" ? "Stock" : t.name == "products" ? "Products" : "Stores"), saving=saving, failed=failed, offline=offline, waiting=stock.waiting, web=(host.web or android), signOut=askSignOut)
                  // A web page: the content keeps a readable width, centred, on a wide window.
                  column flex=1 min-height=0 width="100%" max-width="55rem" margin="0px auto" position="relative"
                    // Why the last change didn't save, or that the counts shown may be old.
                    // A failed add says why under its own field instead.
                    if (failed and lastWrite != "added") or stock.dropped != "" or offline
                      text ((failed and lastWrite != "added") ? saveError : stock.dropped != "" ? stock.dropped : "Can’t reach the server, so this may be out of date. Trying again every 10 seconds.")
                        role="alert" testId="notice" font-size="0.875rem" color="out.ink" background-color="out.fill" padding="8px 16px"
                    if t.name == "stock"
                      if stores.items.length == 0
                        // A failed first load is not an empty list: the notice says why nothing shows.
                        if not pending(stores) and not failed(stores)
                          // An empty screen says what to do and offers it, in the list's place (Exact's EmptyState).
                          EmptyState(symbol="symbol:icon.storefront", title="No Stores Yet", message="Add a store to start counting its stock.")
                            button press=tab("stores") testId="no-stores"
                              text "Add a Store"
                      else
                        // exact-accept lower-list-beside-fixed
                        column padding="4px 16px 16px" gap="12px" background-color="surface" border-bottom="1px solid" border-bottom-color="line"
                          button press=openStores popovertarget=(host.web ? "store-menu" : "") aria-label=`Store: ${currentName}. Change store` testId="store" appearance="none" -exact-hover-effect="highlight" class=Press
                            display="flex" align-items="center" gap="10px" padding="10px 12px" text-align="left" width="100%" box-sizing="border-box"
                            background-color="surface" border="1px solid" border-color="line" border-radius="12px"
                            column flex=1 min-width=0
                              text "Counting at" font-size="0.75rem" color="ink.muted"
                              text currentName font-size="1.0625rem" font-weight=700 color="ink.strong"
                                line-clamp=2 overflow-wrap="break-word" testId="store-name"
                            image "symbol:chooser" aria-hidden=true color="brand"
                          row gap="6px"
                            Chip(label=`All ${stock.lines.length}`, on=(not needsOnly), press=showRestock(false), id="filter-all")
                            Chip(label=`Needs restock ${restock.length}`, on=needsOnly, press=showRestock(true), id="filter-restock")
                        if stock.store != current
                          column padding="24px" align-items="center"
                            progress aria-label="Loading" testId="loading"
                        else if stock.lines.length == 0
                          EmptyState(symbol="symbol:package", title="No Products Yet", message="Add a product to count it at every store.")
                            button press=tab("products") testId="no-products"
                              text "Add a Product"
                        else if shown.length == 0
                          EmptyState(symbol="symbol:checkmark", title="All Stocked", message="Nothing at this store needs restocking.")
                            button press=showRestock(false) testId="all-stocked"
                              text "Show All"
                        else
                          scroll flex=1 min-height=0
                            // Room for the undo message so it never covers the last row.
                            column padding-bottom="80px"
                              for l in shown key=l.id
                                row testId=`line-${l.id}` align-items="center" flex-wrap="wrap" gap="12px" padding="12px 16px"
                                  border-bottom="1px solid" border-bottom-color="line" background-color=(l.count == 0 ? "out.row" : "surface")
                                  column flex="1 1 8rem" min-width=0
                                    text l.name font-size="1rem" color="ink" overflow-wrap="break-word"
                                    if l.count == 0
                                      Level(label="Out of stock", out=true)
                                    else if isLow(l.count)
                                      Level(label="Low", out=false)
                                  row align-items="center" flex-shrink=0 margin-left="auto" padding="2px" font-size="min(-exact-body, 20px)" border-radius="12px" background-color="surface.tint"
                                    button press=adjust(l.id, -1) disabled=(l.count == 0) aria-label=`Remove one ${l.name}` testId=`minus-${l.id}`
                                      appearance="none" -exact-hover-effect="highlight" class=Press border="none" background-color="transparent" width="2.75em" height="2.75em" border-radius="10px"
                                      display="flex" align-items="center" justify-content="center" padding=0
                                      image "symbol:minus" color=(l.count == 0 ? "ink.disabled" : "brand")
                                    input inputmode="numeric" appearance="none" value=(countId == l.id ? countDraft : `${l.count}`)
                                      input=editCount(l.id, l.count) maxlength=7 blur=saveCount(l.id, l.name, l.count)
                                      aria-label=`${l.name} count at ${currentName}` testId=`count-${l.id}` min-height="44px"
                                      width=`${max(52, (countId == l.id ? countDraft : l.count.toString()).length * 12 + 16) / 18}em` box-sizing="border-box"
                                      text-align="center" font-size="1.125em" font-weight=700 font-variant-numeric="tabular-nums" color="ink"
                                      border="none" background-color="transparent" padding="8px 0px" border-radius="8px"
                                    button press=adjust(l.id, 1) aria-label=`Add one ${l.name}` testId=`plus-${l.id}`
                                      appearance="none" -exact-hover-effect="highlight" class=Press border="none" background-color="transparent" width="2.75em" height="2.75em" border-radius="10px"
                                      display="flex" align-items="center" justify-content="center" padding=0
                                      image "symbol:add" color="brand"
                        if canUndo
                          row role="status" testId="undo-toast" font-size="min(-exact-body, 20px)" position="absolute" left="16px" right="16px" bottom="16px" align-items="center" gap="12px"
                            padding="12px 14px" border-radius="14px" background-color="toast.fill"
                            text `${undoName} set to ${undoCount}` color="toast.ink" font-size="0.875em" flex=1 min-width=0 line-clamp=2
                            button press=undo testId="undo" appearance="none" -exact-hover-effect="highlight" class=Press border="none" background-color="transparent" padding=0
                              text "Undo" color="toast.action" font-weight=700 font-size="0.875em"
                    else
                      // Products and Stores are React Native's NameList: one add row, then a row per name.
                      row align-items="center" padding="12px 16px" border-bottom="1px solid" border-bottom-color="line.list"
                        input value=(t.name == "products" ? newProduct : newStore) input=editNew(t.name) submit=addNew(t.name) maxlength=100
                          placeholder=(t.name == "products" ? "New product, e.g. Oat milk 1L" : "New store location")
                          aria-label=(t.name == "products" ? "New product" : "New store") testId=`new-${t.name}` flex=1 min-width=0
                          aria-invalid=((t.name == "products" ? productNote : storeNote) != "")
                          appearance="none" min-height="44px" box-sizing="border-box" font-size="1rem" color="ink" padding="8px 10px" border="1px solid" border-color="line.field" border-radius="6px"
                          ::placeholder
                            color="ink.muted"
                        button press=addNew(t.name) disabled=((t.name == "products" ? dupProduct : dupStore) != "") testId=`add-${t.name}` appearance="none" min-height="44px" box-sizing="border-box" -exact-hover-effect="highlight" class=Press margin-left="8px" padding="10px 16px"
                          border="none" border-radius="6px" background-color="brand" opacity=((t.name == "products" ? dupProduct : dupStore) != "" ? 0.5 : 1)
                          text "Add" font-size="0.875rem" font-weight=600 color="ink.on-brand"
                      if (t.name == "products" ? productNote : storeNote) != ""
                        text (t.name == "products" ? productNote : storeNote) role="status" testId=`add-note-${t.name}`
                          font-size="0.875rem" color="out.ink" padding="8px 16px" border-bottom="1px solid" border-bottom-color="line.list"
                      if host.web
                        scroll flex=1 min-height=0
                          for it in (t.name == "products" ? products.items : stores.items) key=it.id
                            row testId=`${t.name}-${it.id}` align-items="center" flex-wrap="wrap" column-gap="8px" padding="12px 16px" border-bottom="1px solid" border-bottom-color="line.list"
                              text it.name font-size="1rem" color="ink" flex="1 1 8rem" min-width=0 overflow-wrap="break-word"
                              button press=askRemove(t.name, it.id, it.name) aria-label=`Delete ${it.name}` testId=`${t.name}-${it.id}-delete`
                                appearance="none" -exact-hover-effect="highlight" class=Press margin-left="auto" border="none" background-color="transparent" padding=0
                                text "Delete" font-size="0.875rem" color="ink.delete"
                      else
                        // On a phone, a row swipes left to Delete, as in Mail; it still asks before it deletes.
                        list appearance="auto" listStyle="plain" flex=1 min-height=0
                          section
                            for it in (t.name == "products" ? products.items : stores.items) key=it.id
                              row delete=askRemove(t.name, it.id, it.name) testId=`${t.name}-${it.id}`
                                text it.name overflow-wrap="break-word"
      // The tabs. On the web, a web app's row across the top (order -1), centred to the content's width.
      // On a phone, left to the platform: iOS's tab bar at the bottom, in reach of a thumb.
      // accent-color tints the selected tab (and each tab's screen) in the brand brown, not iOS's blue.
      row role="tablist" appearance=(host.web ? "none" : "auto") testId="tabs" display=(signedIn ? "flex" : "none") accent-color="brand"
        order=(host.web ? -1 : 0) align-items="center" gap="4px" box-sizing="border-box"
        padding=(host.web ? "8px max(8px, calc((100% - 55rem) / 2 + 8px))" : "0px")
        background-color=(host.web ? "surface.header" : "transparent") border="none" border-bottom=(host.web ? "1px solid" : "none") border-bottom-color="line"
        for t in nav.tabs key=t.name
          if host.web
            button role="tab" aria-controls=`panel-${t.name}` aria-selected=(nav.tab == t.name) press=tab(t.name) testId=`tab-${t.name}`
              appearance="none" -exact-hover-effect="highlight" class=Press display="flex" flex=1 justify-content="center" align-items="center" gap="6px" padding="8px 12px" border="none" border-radius="8px"
              background-color=(nav.tab == t.name ? "surface.chip" : "transparent") color=(nav.tab == t.name ? "brand" : "ink.nav-dim")
              image (t.name == "stock" ? "symbol:package" : t.name == "products" ? "symbol:list" : "symbol:icon.storefront") aria-hidden=true
              text (t.name == "stock" ? "Stock" : t.name == "products" ? "Products" : "Stores") font-size="0.9375rem" font-weight=600
          else
            // A symbol over a label: a tab bar item.
            button role="tab" aria-controls=`panel-${t.name}` aria-selected=(nav.tab == t.name) press=tab(t.name) testId=`tab-${t.name}`
              image (t.name == "stock" ? "symbol:package" : t.name == "products" ? "symbol:list" : "symbol:icon.storefront")
              text (t.name == "stock" ? "Stock" : t.name == "products" ? "Products" : "Stores")
      if not signedIn
        // A root overlay over the hidden tabs (after them, positioned): iOS draws the tabs' native
        // container over anything beside the routes, so a sign-in in the flow would be covered.
        column position="absolute" inset=0 display="flex" background-color="surface"
          // A compact sign-in form, centred in the window.
          column flex=1 justify-content="center" width="100%" max-width="24rem" margin="0px auto" box-sizing="border-box" padding="24px"
            text "Co-op Inventory" role="heading" aria-level=1 font-size="1.5rem" font-weight=700 letter-spacing="-0.01em" color="ink.strong" margin-bottom="4px"
            text "Enter your team code to see store inventory." font-size="0.9375rem" color="ink.muted" margin-bottom="16px"
            // A phone stacks the field over a full-width button, in easy reach of a thumb; the web keeps one row.
            row flex-direction=(host.web ? "row" : "column") gap=(host.web ? "8px" : "12px")
              input type="password" value=draftCode input=editCode submit=signIn placeholder="Team code"
                aria-label="Team code" autocapitalize="none" autocorrect="off" enterkeyhint="go" testId="code" flex=1 min-width=0 appearance="none" min-height="44px" box-sizing="border-box"
                font-size="1rem" color="ink" padding="8px 10px" border="1px solid" border-color="line.field" border-radius="6px"
                ::placeholder
                  color="ink.muted"
              button press=signIn testId="sign-in" appearance="none" min-height=(host.web ? "44px" : "48px") -exact-hover-effect="highlight" class=Press padding="10px 16px"
                display="flex" align-items="center" justify-content="center"
                border="none" border-radius="6px" background-color="brand"
                text "Sign in" font-size="0.875rem" font-weight=600 color="ink.on-brand"
            if signInError != ""
              text signInError font-size="0.875rem" color="ink.delete" margin-top="12px" testId="sign-in-error"
      // The web's store picker: a dropdown as wide as the store button (the content column's 55rem less
      // its 16 px padding each side; Exact has no anchor-size()), anchored under it (popovertarget),
      // closed by Escape or a click elsewhere. A phone uses the pick route's sheet instead.
      if host.web
        column id="store-menu" popover="auto" aria-label="Choose a store" position-area="bottom span-right"
          position-try-fallbacks="flip-block" width="min(calc(55rem - 32px), calc(100vw - 32px))" max-height="60vh" margin="6px 0px"
          box-sizing="border-box" padding="8px" border="1px solid" border-color="line" border-radius="12px"
          transform-origin="top left" animation=(media.prefersReducedMotion ? "none" : "menuIn 160ms cubic-bezier(0.23, 1, 0.32, 1)")
          background-color="surface" box-shadow="0px 8px 24px var(--shadow)"
          input value=storeQuery input=editStoreQuery submit=pickFirstStore placeholder="Search stores"
            aria-label="Search stores" appearance="none" testId="store-search" width="100%" box-sizing="border-box"
            font-size="1rem" color="ink" padding="10px 12px" border="none" border-radius="10px" background-color="surface.tint" margin-bottom="8px"
          scroll flex=1 min-height=0
            for s in storeMatches key=s.id
              button press=pickStore(s.id) aria-pressed=(s.id == current) testId=`pick-${s.id}` appearance="none" -exact-hover-effect="highlight" class=Press
                display="flex" align-items="center" gap="8px" width="100%" box-sizing="border-box" padding="10px 8px" text-align="left"
                border="none" border-radius="8px" background-color="transparent"
                // exact-accept lower-text-px-width
                text (s.id == current ? "✓" : "") width="16px" flex-shrink=0 color="brand" font-weight=700
                // The name gets the whole width; its badges sit under it, as on a Stock row.
                column flex=1 min-width=0
                  text s.name font-size="1rem" color=(s.id == current ? "brand" : "ink") font-weight=(s.id == current ? 600 : 400) overflow-wrap="break-word"
                  row gap="6px"
                    if s.out > 0
                      Level(label=`${s.out} out`, out=true)
                    if s.low > 0
                      Level(label=`${s.low} low`, out=false)
            if storeMatches.length == 0
              text `No stores match “${storeQuery}”` color="ink.empty" padding="12px"
      // React Native asks with Alert.alert (iOS) or the browser's confirm() (web): this question, Cancel and Delete.
      // The text line makes it an alert: without one it is a chooser, which Android does not show.
      dialog id="remove" role="alertdialog" aria-label=`Delete ${doomedName} and its stock counts?`
        text "This can’t be undone."
        button commandfor="remove" command="close" testId="remove-cancel"
          text "Cancel"
        button press=remove destructive=true commandfor="remove" command="close" testId="remove-confirm"
          text "Delete"
      dialog id="sign-out" role="alertdialog" aria-label="Sign out of this device?"
        // Taps not yet on the server are lost with the device's copy, so say how many.
        text (stock.waiting == 1 ? "1 change on this device hasn’t reached the server yet and will be lost. You’ll need the team code to sign in again."
          : stock.waiting > 1 ? `${stock.waiting} changes on this device haven’t reached the server yet and will be lost. You’ll need the team code to sign in again.`
          : "You’ll need the team code to sign in again.") testId="sign-out-message"
        button commandfor="sign-out" command="close" testId="sign-out-cancel"
          text "Cancel"
        button press=signOut destructive=true commandfor="sign-out" command="close" testId="sign-out-confirm"
          text "Sign Out"

// Every tab's title, with whether the last change reached the server (React Native's SyncStatus).
component Bar
  props
    title: string
    saving: bool
    failed: bool
    offline: bool
    waiting: number
    web: bool
    signOut: action
  view
    // Drawn as written on the web, centred to the content's width; on a phone, the platform's bar.
    header appearance=(web ? "none" : "auto") display="flex" flex-wrap="wrap" row-gap="8px" align-items="center" box-sizing="border-box"
      padding="20px max(16px, calc((100% - 55rem) / 2 + 16px)) 12px" background-color="surface"
      // Sign Out leads on iOS, as the bar's leading item. Where the header is drawn as written (the web,
      // and Android, whose leading spot is Back or a menu), it trails, as an action does.
      if not web
        button press=signOut testId="sign-out" color="brand" margin-right="12px"
          text "Sign Out"
      text title role="heading" aria-level=1 font-size="1.5rem" font-weight=700 letter-spacing="-0.01em" color="ink.strong" min-width=0
      column flex=1
      row align-items="center" gap="6px" role="status" testId="sync"
        column width="6px" height="6px" border-radius="3px"
          background-color=(saving ? "status.saving" : failed or offline ? "out.ink" : "status.saved")
        text (saving ? "Saving…" : failed ? "Not saved" : offline and waiting > 0 ? `Offline · ${waiting} waiting` : offline ? "Offline" : "Saved") font-size="0.75rem" color=(failed or offline ? "out.ink" : "ink.muted") testId="sync-label"
      // Plain text, quieter than the page's actions: used rarely. 44px tall for a finger; the negative
      // margins keep its text on the content's edge and the header no taller than the title.
      if web
        button press=signOut testId="sign-out" appearance="none" -exact-hover-effect="highlight" class=Press min-height="44px" box-sizing="border-box"
          margin="-8px -12px -8px 4px" padding="0px 12px" border="none" border-radius="8px" background-color="transparent"
          text "Sign Out" font-size="0.875rem" font-weight=500 color="brand"

// An "Out of stock" or "Low" pill.
component Level
  props
    label: string
    out: bool
  view
    text label align-self="flex-start" margin-top="4px" padding="2px 8px" border-radius="999px" font-size="0.75rem" font-weight=600
      color=(out ? "out.ink" : "low.ink") background-color=(out ? "out.fill" : "low.fill")

component Chip
  props
    label: string
    on: bool
    press: action
    id: string
  view
    button press=press aria-pressed=on testId=id appearance="none" -exact-hover-effect="highlight" class=Press min-height="44px" box-sizing="border-box" display="flex" align-items="center" padding="7px 14px" border="none" border-radius="999px"
      background-color=(on ? "brand" : "surface.chip")
      text label font-size="0.8125rem" font-weight=600 color=(on ? "ink.on-brand" : "ink.muted")
