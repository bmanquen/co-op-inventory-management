// `test` and `verify` start server.ts on an empty scratch database for each test (never Turso),
// where the team code is `test-code`.
test "a wrong team code is refused; the right one signs in"
  type "code" "nope"
  tap "sign-in"
  clock data
  expect text "sign-in-error" == "Wrong team code."
  type "code" "test-code"
  tap "sign-in"
  clock data
  clock settle
  expect state code == "test-code"
  tap "no-stores"
  expect state nav.tab == "stores"
  tap "sign-out"
  clock settle
  tap "sign-out-cancel"
  clock settle
  expect state code == "test-code"
  tap "sign-out"
  clock settle
  tap "sign-out-confirm"
  clock data
  expect state code == ""
  expect tree has "sign-in"

test "a saved code the server no longer accepts asks again"
  stored code "old-code"
  clock data
  expect text "sign-in-error" == "Wrong team code."

test "count stock, see what needs restocking, type a count and undo it"
  stored code "test-code"
  request POST "/stores" {"name": "Downtown"} as test-code
  request POST "/stores" {"name": "Airport"} as test-code
  request POST "/products" {"name": "House Blend"} as test-code
  request POST "/products" {"name": "Decaf"} as test-code
  clock +10000
  clock data
  clock settle
  expect state current == "2"
  expect text "store-name" == "Airport"
  expect text "sync-label" == "Saved"
  expect disabled "minus-1"
  tap "plus-1"
  tap "plus-1"
  expect text "count-1" == "2"
  clock data
  expect text "count-1" == "2"
  expect text "filter-restock" == "Needs restock 2"
  // Typing alone saves nothing; leaving the field saves (iOS's Return leaves it too, the web's Enter doesn't).
  type "count-1" "12"
  clock data
  expect tree missing "undo-toast"
  type "count-1" key "Tab"
  clock data
  expect text "count-1" == "12"
  expect tree has "undo-toast"
  tap "filter-restock"
  expect tree missing "line-1"
  expect tree has "line-2"
  // Someone else adds one meanwhile: Undo takes back only this change, so their tap stays (12 + 1 − 10 = 3).
  request POST "/adjust" {"storeId": 2, "productId": 1, "delta": 1} as test-code
  tap "undo"
  clock data
  expect text "count-2" == "0"
  tap "filter-all"
  expect text "count-1" == "3"
  // The count field takes digits only: a letter is dropped, and letters alone change nothing.
  type "count-1" "4o"
  expect text "count-1" == "4"
  // A letter after digits is dropped as it's typed, even though the digits didn't change (expo/exact#1733).
  type "count-1" "40"
  type "count-1" "40a"
  expect text "count-1" == "40"
  type "count-1" "1,500"
  type "count-1" key "Tab"
  clock data
  expect text "count-1" == "1500"
  type "count-1" "abc"
  type "count-1" key "Tab"
  clock data
  expect text "count-1" == "1500"
  clock +4000
  expect tree missing "undo-toast"

test "the store sheet searches and remembers the pick"
  stored code "test-code"
  request POST "/stores" {"name": "Downtown"} as test-code
  request POST "/stores" {"name": "Airport"} as test-code
  request POST "/products" {"name": "House Blend"} as test-code
  clock +10000
  clock data
  clock settle
  tap "store"
  clock settle
  type "store-search" "down"
  // On iOS the keyboard raises the sheet; let it land before tapping a row.
  clock settle
  expect tree missing "pick-2"
  tap "pick-1"
  clock data
  clock settle
  expect text "store-name" == "Downtown"
  expect state picked == "1"

test "add stores and products, delete a product"
  stored code "test-code"
  clock data
  tap "tab-stores"
  type "new-stores" "Downtown"
  tap "add-stores"
  clock data
  expect state newStore == ""
  expect tree has "stores-1"
  // The same name again, in any case, says so under the field as it's typed, and can't be added.
  type "new-stores" "downtown"
  expect text "add-note-stores" == "“Downtown” is already on the list."
  expect disabled "add-stores"
  type "new-stores" key "Enter"
  clock data
  expect state newStore == "downtown"
  expect tree missing "stores-2"
  type "new-stores" ""
  expect tree missing "add-note-stores"
  tap "tab-products"
  type "new-products" "House Blend"
  tap "add-products"
  clock data
  type "new-products" "Decaf"
  type "new-products" key "Enter"
  clock data
  expect tree has "products-2"
  tap "products-1-delete"
  clock settle
  tap "remove-confirm"
  clock data
  expect tree missing "products-1"
  tap "tab-stock"
  clock data
  expect tree missing "line-1"
  expect tree has "line-2"

test "a save that fails keeps what was typed and says why"
  stored code "test-code"
  clock data
  tap "tab-products"
  fail fetch "http://127.0.0.1:8787"
  type "new-products" "House Blend"
  tap "add-products"
  clock data
  expect state newProduct == "House Blend"
  expect text "sync-label" == "Not saved"
  expect text "add-note-products" == "Can’t reach the server. Check your connection and try again."
  pass fetch "http://127.0.0.1:8787"
  tap "add-products"
  clock data
  expect state newProduct == ""
  expect tree has "products-1"
  expect text "sync-label" == "Saved"
  request POST "/stores" {"name": "Downtown"} as test-code
  tap "tab-stock"
  clock +10000
  clock data
  request DELETE "/products/1" as test-code
  tap "plus-1"
  clock data
  expect text "notice" == "That product or store was removed. The list is up to date now."

test "a server it can't reach is not an empty list"
  stored code "test-code"
  fail fetch "http://127.0.0.1:8787"
  clock data
  expect tree missing "no-stores"
  expect text "sync-label" == "Offline"
  expect tree has "notice"
  pass fetch "http://127.0.0.1:8787"
  clock +10000
  clock data
  expect tree has "no-stores"
  expect tree missing "notice"

test "an old failed delete doesn't say Not saved once later saves work"
  stored code "test-code"
  request POST "/stores" {"name": "Downtown"} as test-code
  request POST "/products" {"name": "House Blend"} as test-code
  request POST "/products" {"name": "Decaf"} as test-code
  clock +10000
  clock data
  tap "tab-products"
  tap "products-1-delete"
  clock settle
  fail fetch "http://127.0.0.1:8787"
  tap "remove-confirm"
  clock data
  expect text "sync-label" == "Not saved"
  pass fetch "http://127.0.0.1:8787"
  tap "tab-stock"
  clock +10000
  clock data
  tap "plus-2"
  clock data
  expect text "count-2" == "1"
  expect text "sync-label" == "Saved"
  expect tree missing "notice"

test "text typed while an add saves stays in the field"
  stored code "test-code"
  clock data
  tap "tab-products"
  // The server takes House Blend 200 ms later, while Decaf is being typed.
  answer fetch "http://127.0.0.1:8787/products" method POST with 201 {"ok": true} after 200
  type "new-products" "House Blend"
  tap "add-products"
  type "new-products" "Decaf"
  clock +200
  clock data
  expect state newProduct == "Decaf"
